# Environment Configuration
# Copy this file to .env and fill in the values.
# Command: cp .env.example .env   (macOS/Linux)
#          copy .env.example .env  (Windows)
#
# IMPORTANT: Never commit .env to version control.
# The .env file is already excluded via .gitignore.

# ─────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────

# HTTP port the server listens on.
# Cloud platforms (Railway, Render) inject this automatically.
# Locally, defaults to 8000 if not set.
PORT=8000

# ─────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────

# Path to the SQLite database file.
# Relative to the project root. Change this to use a different location.
# For production at scale, migrate to PostgreSQL and provide a DATABASE_URL instead.
DB_PATH=tickets.db

# ─────────────────────────────────────────────
# OPTIONAL: FUTURE LLM INTEGRATION
# ─────────────────────────────────────────────

# If you extend the agent to use an external LLM API, add your key here.
# The current version does NOT require an API key — it runs fully offline.

# GOOGLE_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# ─────────────────────────────────────────────
# OPTIONAL: APPLICATION SETTINGS
# ─────────────────────────────────────────────

# Set to "production" or "development"
# APP_ENV=development

# Override the log level (debug, info, warning, error)
# LOG_LEVEL=info
