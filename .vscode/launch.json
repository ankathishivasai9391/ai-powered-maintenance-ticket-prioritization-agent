{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 FastAPI Server (Dev)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.app:app",
                "--host", "127.0.0.1",
                "--port", "8000",
                "--reload"
            ],
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "🧪 Run All Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/",
                "-v",
                "--tb=short"
            ],
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "🌐 E2E API Test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/e2e_test.py",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
            "preLaunchTask": "wait-for-server"
        },
        {
            "name": "📊 Run Evaluation",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.app:app",
                "--host", "127.0.0.1",
                "--port", "8000"
            ],
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "🔥 Full Stack Debug",
            "configurations": ["🚀 FastAPI Server (Dev)"]
        }
    ]
}
